{
  "name": "alarm-saham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sectors": "node --env-file-if-exists=.env.local --import tsx scripts/sectors.ts",
    "data-proof": "node --env-file-if-exists=.env.local --import tsx scripts/data-proof.ts",
    "backtest": "node --env-file-if-exists=.env.local --import tsx scripts/backtest.ts",
    "agent:demo": "node --env-file-if-exists=.env.local --import tsx scripts/agent-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.93",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
