# Salin file ini menjadi .env.local lalu isi nilainya. .env.local TIDAK pernah masuk git.
#
# Isi berkas ini = SELURUH variabel yang benar-benar dibaca kode. Yang tidak
# ditulis di sini tidak akan berpengaruh. Urutannya: (1) yang diisi untuk deploy,
# (2) penyetel lanjutan yang punya nilai bawaan aman, (3) yang HANYA untuk
# pengembangan/tes dan tidak boleh diset di produksi.
#
# Aplikasi tetap berjalan tanpa satu kunci pun: halaman memakai data contoh
# (dengan label "data contoh"), fitur AI menjawab 503, notifikasi masuk ke kotak
# masuk in-app. Lihat README bagian "Cara menjalankan".

# ============================================================================
# 1. Diisi untuk deploy (Vercel: Project → Settings → Environment Variables)
# ============================================================================

# Sectors Financial API (Insider) — sumber data inti. Tanpa ini tidak ada
# penarikan data baru; halaman tetap jalan dari data yang sudah di database.
SECTORS_API_KEY=

# Neon Postgres — tempat data Sectors, alarm, portofolio, kotak masuk.
# Salin "Connection string" apa adanya dari dasbor Neon (diawali postgresql://,
# akhiri dengan ?sslmode=require). Contoh lengkapnya sengaja tidak ditulis di
# sini: bentuk URL berkredensial adalah salah satu pola yang ditolak pemindai
# rahasia (npm run scan:history), termasuk kalau ditulis sebagai contoh.
# KOSONG DI PRODUKSI = server memakai data contoh 8 emiten (berlabel "data
# contoh") dan menolak menyimpan portofolio. Isi ini sebelum deploy.
DATABASE_URL=

# ---- Otak AI (perakit blok & diagnosis). Cukup isi SATU jalur.
#
# JALUR TERMUDAH: gateway OpenAI-compatible (satu kunci, banyak model).
# Contoh Command Code (https://commandcode.ai/docs/provider):
#   LLM_BASE_URL=https://api.commandcode.ai/provider/v1
#   LLM_API_KEY=<kunci Anda>
#   LLM_MODEL=deepseek/deepseek-v4-flash
# Daftar model hidup: GET <LLM_BASE_URL>/models
# Catatan: pilih model non-Claude; model Claude di Command Code memakai jalur
# /messages, sedangkan kita memakai /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=

# Model untuk agent diagnosis & perakit blok (WAJIB diisi bila memakai gateway,
# karena nama model gateway berbeda dari nama DeepSeek langsung).
#
# PILIH MODEL CEPAT, BUKAN YANG PALING PINTAR. Terukur pada gateway Kagiro
# (2026-09-12, universe Neon 104 emiten, lihat docs/decisions.md):
#   deepseek-v4-flash : 2/2 berhasil, 52-63 detik, ~52 ribu token
#   deepseek-v4-pro   : 200-418 detik dan sering gagal (galat kapasitas
#                       "Layanan sedang penuh"/"Bad Gateway" 0/6 pada satu sesi)
# Batas fungsi Vercel plan Hobby 300 detik, jadi model penalaran yang lambat
# memang tidak bisa dipakai di jalur permintaan web.
LLM_MODEL=kagiro/deepseek-v4-flash

# Model murah untuk fase perangkum diagnosis & penjelasan harian.
# Kosong = ikut LLM_MODEL.
LLM_MODEL_RINGAN=

# Provider: "deepseek" (termasuk jalur gateway di atas) atau "anthropic".
# Kosongkan = otomatis: jalur deepseek/gateway bila LLM_API_KEY atau
# DEEPSEEK_API_KEY terisi, kalau tidak Anthropic.
LLM_PROVIDER=

# DeepSeek — cara dapat kunci: daftar di https://platform.deepseek.com, buka
# menu "Top up" dan isi saldo prabayar kecil (mis. US$2 sudah cukup untuk
# ratusan diagnosis), lalu menu "API keys" -> "Create new API key". Kunci hanya
# ditampilkan sekali; tempel di sini.
DEEPSEEK_API_KEY=

# Model DeepSeek (default deepseek-v4-flash = paling murah). Alias lama
# deepseek-chat / deepseek-reasoner sudah dipensiunkan DeepSeek (24 Jul 2026).
DEEPSEEK_MODEL=deepseek-v4-flash

# Isi 1 agar diagnosis & perakit memakai deepseek-v4-pro (lebih pintar, ~3x lebih mahal)
DEEPSEEK_REASONER=

# Anthropic — alternatif bila punya kunci (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ---- Pengecekan pagi otomatis (tiket 12). Vercel Cron memanggil /api/cron/jaga
# setiap 06:30 WIB. Isi CRON_SECRET dengan teks acak panjang (>= 16 karakter);
# Vercel otomatis mengirimnya sebagai "Authorization: Bearer ..." dan endpoint
# menolak permintaan lain. Kosong = endpoint cron dinonaktifkan (503).
CRON_SECRET=

# Telegram bot dari @BotFather — notifikasi alarm (fase 3, OPSIONAL).
# Kosong = notifikasi tampil di "Kotak masuk" halaman /pasang saja (PLAN §7.5);
# cron tetap berjalan. Bila diisi, pengguna mengetik /mulai <kode-portofolio>
# ke bot agar bendera baru dikirim ke chat-nya tiap pagi.
TELEGRAM_BOT_TOKEN=

# Kata sandi webhook Telegram (teks acak, 1-256 karakter huruf/angka/_/-).
# Telegram mengirimnya di setiap update; server menolak yang tidak cocok.
# Daftarkan webhook sekali: npm run telegram:set-webhook -- https://<app>.vercel.app
TELEGRAM_WEBHOOK_SECRET=

# Alamat aplikasi setelah deploy. Hanya dipakai skrip telegram:set-webhook bila
# URL-nya tidak diberikan langsung di baris perintah. Bukan rahasia.
APP_URL=

# ============================================================================
# 2. Penyetel lanjutan — semuanya punya nilai bawaan yang aman, isi hanya bila
#    memang berbeda di tim Anda
# ============================================================================

# Anggaran kredit Sectors tim (bawaan 1000, sesuai jatah hackathon). Pagar
# cadangan di bawah dihitung dari angka INI: sisa = anggaran - terpakai. Kalau
# jatah tim Anda bukan 1000, isi di sini, kalau tidak pagarnya salah hitung.
SECTORS_CREDIT_BUDGET=

# Batas kredit Sectors: kode menolak panggilan API baru jika sisa < angka ini
SECTORS_CREDIT_RESERVE=250

# Isi 1 HANYA untuk menembus pagar di atas (mis. demo juri saat sisa menipis).
# Setiap panggilan tetap tercatat di buku kredit.
ALLOW_RESERVE=

# ============================================================================
# 3. Hanya untuk pengembangan/tes — JANGAN diset di produksi
# ============================================================================

# Folder cache/buku kredit berbasis berkas saat DATABASE_URL kosong
# (bawaan .cache/sectors). Di serverless sistem berkas hanya-baca, jadi jalur
# berkas ini memang tidak dipakai di produksi.
SECTORS_CACHE_DIR=

# Mengalihkan SELURUH panggilan Sectors ke host lain (server tiruan saat tes).
# Header Authorization ikut ke sana — karena itu nilai non-lokal DIABAIKAN saat
# NODE_ENV=production.
SECTORS_BASE_URL=

# Isi 1 untuk memaksa jalur data contoh walau folder ./.pglite ada (meniru
# kondisi deploy tanpa database).
TANPA_PGLITE=

# Folder PGlite selain ./.pglite (hanya berpengaruh saat DATABASE_URL kosong,
# jadi nol pengaruh di produksi). Dipakai gerbang e2e jalur database di CI:
# `npm run e2e:seed -- --dir=.pglite-e2e` membangun database dari benih yang
# di-commit, dan ./.pglite hasil penarikan universe Anda tidak tersentuh.
ALARM_PGLITE_DIR=

# Memakukan "hari ini" (YYYY-MM-DD) untuk seluruh aplikasi. Dipakai e2e agar
# hasil layar tidak berubah seiring hari berjalan.
# KHUSUS PENGEMBANGAN/TES — biarkan KOSONG di dasbor deploy. Sejak tiket 15
# nilainya DIABAIKAN saat NODE_ENV=production (dengan peringatan di log), supaya
# nilai yang tanpa sengaja tersalin ke Vercel tidak membekukan seluruh aplikasi
# di satu tanggal secara diam-diam.
ALARM_HARI_INI=

# Kunci kedua yang wajib menyertai ALARM_HARI_INI kalau waktu memang sengaja
# dibekukan di build produksi (dipakai server e2e: `next start` = production).
# Isi 1 hanya bila Anda benar-benar ingin aplikasi berhenti mengikuti hari nyata;
# log akan mencetak peringatan mencolok setiap proses hidup.
ALARM_IZINKAN_BEKU_WAKTU=

# Isi "pglite" agar tes integrasi skema memakai PGlite in-memory alih-alih
# menjalankan container postgres:16 (dipakai CI).
ALARM_TEST_DB=

# Playwright: port server e2e (bawaan 3100, atau 3101 bila E2E_TANPA_PGLITE=1),
# 1 = pakai .next yang sudah ada, 1 = paksa jalur data contoh + skip spec yang
# butuh data nyata, dan folder PGlite untuk server e2e (diteruskan sebagai
# ALARM_PGLITE_DIR; dipakai job CI `e2e-db`).
E2E_PORT=
E2E_SKIP_BUILD=
E2E_TANPA_PGLITE=
E2E_PGLITE_DIR=
